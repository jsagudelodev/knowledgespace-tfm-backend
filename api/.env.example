# ── Observabilidad / Langfuse (opcional) ──────────────────────────────────────
# Trazas del pipeline RAG: la consulta, los fragmentos recuperados con su
# puntuación, si superan el umbral, y la generación con sus tokens y su costo.
#
# Es OPCIONAL: con LANGFUSE_ENABLED=false la aplicación funciona igual. Las
# demás credenciales de este archivo son obligatorias porque sin ellas el
# sistema no arranca; sin esta solo se pierden las trazas.
#
# Para obtener las claves: crear un proyecto en Langfuse Cloud (plan gratuito)
# o levantar Langfuse en local con Docker, y copiar la clave pública y la
# secreta de la configuración del proyecto.
#
# OJO CON LA REGIÓN. Langfuse Cloud tiene dos, con hosts distintos:
#     Europa          https://cloud.langfuse.com
#     Estados Unidos  https://us.cloud.langfuse.com
# Unas claves de una región contra el host de la otra devuelven 401 con el
# mensaje "Invalid credentials. Confirm that you've configured the correct
# host.", que se parece a unas claves mal copiadas y no lo es.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# ── Estrategia de recuperación ────────────────────────────────────────────────
# Qué configuración del pipeline RAG atiende el chat. Las tres conviven y están
# medidas en el capítulo 5 de la memoria; esta variable elige cuál se usa.
#
#   base             Naive RAG con filtro por umbral. La línea base de todos
#                    los experimentos.
#   descomposicion   + descomposición de consultas. Cobertura conjunta de las
#                    preguntas compuestas del 48 % al 88 %. +1,2 s de latencia
#                    mediana, y solo encarece la consulta que descompone.
#   reranking        + reordenado de fragmentos. hit@3 de 0,500 a 0,667, pero
#                    sin mejora medible en las respuestas y con un coste 3,7
#                    veces mayor por consulta.
#   descomposicion_acotada   descomposición CON tope de contexto: reparte los cinco
#                    fragmentos entre las subpreguntas en vez de enviar uno
#                    por cada una. Mismo reparto que `descomposicion` (3/2 en
#                    las seis parejas medidas) con la mitad del contexto y el
#                    coste de `base`.
#
# Un valor no reconocido no rompe el servicio: recurre a `base` y lo avisa en
# el log.
RAG_CONFIGURACION=descomposicion_acotada

# ── Parámetros del pipeline RAG ───────────────────────────────────────────────
# Todos tienen una medición detrás y todos son ajustables sin tocar código.
# Los valores de abajo son los que midieron los experimentos del capítulo 5:
# cambiarlos invalida esas cifras, así que hazlo a sabiendas.
#
# Fragmentos que se piden al índice POR BÚSQUEDA, no por consulta: una pregunta
# descompuesta hace una búsqueda por cada subpregunta.
RAG_TOP_K=5
#
# Puntuación mínima para que un fragmento llegue al modelo. Medido el
# 2026-10-09: ruido máximo de una consulta ajena 0,258; señal mínima de un
# fragmento legítimo 0,393. El 0,30 cae en esa banda vacía. Subirlo descarta
# evidencia válida; bajarlo admite ruido.
RAG_UMBRAL_RELEVANCIA=0.30
#
# Temperatura del modelo generativo. Era 0,7 y se bajó a 0 tras medirlo: la
# fidelidad pasó de 0,888 a 0,939.
RAG_TEMPERATURA=0.0
RAG_MAX_TOKENS_RESPUESTA=1000
#
# Más de tres subpreguntas suele indicar que el modelo desmenuza una pregunta
# simple en matices en vez de separar temas.
RAG_MAX_SUBPREGUNTAS=3
#
# Solo afectan a la configuración `reranking`, que no está activa.
RAG_CANDIDATOS_REORDENADO=20
RAG_RECORTE_REORDENADO=1000
